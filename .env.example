# The New Wave IT — omgevingsvariabelen
# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# NOOIT secrets committen: .env.local staat in .gitignore.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NOOIT met NEXT_PUBLIC_ prefix. Alleen in server code gebruiken.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://thenewwaveit.com

# --- E-mailnotificaties (Resend) ---
# Server-only. Zonder deze key worden notificaties overgeslagen (formulieren
# blijven wel gewoon werken). Domein moet geverifieerd zijn in Resend.
RESEND_API_KEY=your-resend-api-key
# Afzender op een geverifieerd domein.
MAIL_FROM=The New Wave IT <notificaties@thenewwaveit.com>
# Ontvanger van interne notificaties bij nieuwe aanvragen/sollicitaties.
NOTIFY_EMAIL=people@thenewwaveit.com
